layout {

    focus-ring {
        active-color "#c4b28a"
        inactive-color "#1f1f28"
        urgent-color "#c4746e"
    }

    border {
        active-color "#c4b28a"
        inactive-color "#1f1f28"
        urgent-color "#c4746e"

        width 4
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color "#c4b28a"
        inactive-color "#735c28"
        urgent-color "#c4746e"
    }

    insert-hint {
        color "#c4b28a80"
    }
    preset-column-widths { proportion 0.247; proportion 0.333; proportion 0.5; }
    default-column-width { proportion 0.25; }
    gaps 16
    struts
}

recent-windows {
    highlight {
        active-color "#c4b28a"
        urgent-color "#c4746e"
    }
}
